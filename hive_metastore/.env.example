# Copy this to .env and set real values before `docker compose up`.

# Metastore database (Postgres)
POSTGRES_DB=metastore
POSTGRES_USER=hive
POSTGRES_PASSWORD=change-me

# HiveServer2 basic auth (checked by SimplePasswdAuthenticator, see auth/)
HIVE_USER=admin
HIVE_PASSWORD=change-me

# MinIO (S3-compatible default storage for the Hive warehouse)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
